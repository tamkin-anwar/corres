{
  "name": "corres-icloud-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Opt-in instant alerts for iCloud Mail. Holds one IMAP IDLE connection per watched Inbox and, when mail arrives, sends the same content-free alert Outlook gets. Never fetches a message: it learns only a new message's number.",
  "main": "watcher.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node watcher.js",
    "deploy": "gcloud run deploy corres-icloud-watcher --source=. --region=us-central1 --no-allow-unauthenticated --min-instances=1 --max-instances=1 --no-cpu-throttling --memory=512Mi --set-secrets=APNS_AUTH_KEY=corres-apns-auth-key:latest --set-env-vars=APNS_KEY_ID=$APNS_KEY_ID,APNS_TEAM_ID=$APNS_TEAM_ID,APNS_BUNDLE_ID=$APNS_BUNDLE_ID,ICLOUD_KEY_VERSION=$ICLOUD_KEY_VERSION"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/kms": "^4.5.0",
    "imapflow": "^1.0.170"
  }
}
