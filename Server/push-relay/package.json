{
  "name": "corres-push-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Content-blind push relay for Corres (Gmail, Outlook, and the records the iCloud watcher reads). Never sees message content: notices carry only an account address and a historyId or message id, and this forwards a wake-up push, plus an alert naming only the account and message where the app asked for one.",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "gcloud functions deploy corres-push-relay --gen2 --runtime=nodejs20 --region=us-central1 --source=. --entry-point=corresPushRelay --service-account=corres-relay@corres-509320.iam.gserviceaccount.com --trigger-http --allow-unauthenticated --set-secrets=APNS_AUTH_KEY=corres-apns-auth-key:latest${DEVICECHECK_SECRET:+,DEVICECHECK_KEY=$DEVICECHECK_SECRET:latest} --set-env-vars=APNS_KEY_ID=$APNS_KEY_ID,APNS_TEAM_ID=$APNS_TEAM_ID,APNS_BUNDLE_ID=$APNS_BUNDLE_ID,ICLOUD_KEY_VERSION=$ICLOUD_KEY_VERSION,APP_ATTEST_ENFORCE=${APP_ATTEST_ENFORCE:-0},ACCOUNT_PROOF_ENFORCE=${ACCOUNT_PROOF_ENFORCE:-0},ICLOUD_MAX_WATCHES=${ICLOUD_MAX_WATCHES:-2000},DEVICECHECK_KEY_ID=${DEVICECHECK_KEY_ID:-},DEVICECHECK_DEVELOPMENT=${DEVICECHECK_DEVELOPMENT:-1}",
    "deploy:graph": "gcloud functions deploy corres-push-relay-graph --gen2 --runtime=nodejs20 --region=us-central1 --source=. --entry-point=corresPushRelayGraph --service-account=corres-relay@corres-509320.iam.gserviceaccount.com --trigger-http --allow-unauthenticated --min-instances=1 --set-secrets=APNS_AUTH_KEY=corres-apns-auth-key:latest --set-env-vars=APNS_KEY_ID=$APNS_KEY_ID,APNS_TEAM_ID=$APNS_TEAM_ID,APNS_BUNDLE_ID=$APNS_BUNDLE_ID",
    "deploy:pubsub": "gcloud functions deploy corres-push-relay-pubsub --gen2 --runtime=nodejs20 --region=us-central1 --source=. --entry-point=corresPushRelayPubSub --service-account=corres-relay@corres-509320.iam.gserviceaccount.com --trigger-http --no-allow-unauthenticated --set-secrets=APNS_AUTH_KEY=corres-apns-auth-key:latest --set-env-vars=APNS_KEY_ID=$APNS_KEY_ID,APNS_TEAM_ID=$APNS_TEAM_ID,APNS_BUNDLE_ID=$APNS_BUNDLE_ID"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/kms": "^4.5.0",
    "@google-cloud/functions-framework": "^3.4.0",
    "cbor": "10.0.12"
  }
}
